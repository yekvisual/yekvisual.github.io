---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { KATEGORILER, ZORLUKLAR, kategoriAdi, zorlukAdi } from '../../lib/taxonomy';

const araclar = (await getCollection('araclar')).sort((a, b) => a.data.ad.localeCompare(b.data.ad, 'tr'));
---

<Base title="Araç Dizini" description="Yapay zekâ ile görsel, video, ses ve otomasyon araçları: hangi iş için, ücretsiz mi; her biri için YEK Lab incelemesi.">
  <section class="container section sayfa-bas">
    <p class="kicker kicker-accent reveal">Araç dizini · {araclar.length} araç</p>
    <h1 class="reveal" style="--d:60ms">Hangi iş için hangi araç?</h1>
    <p class="lead giris reveal" style="--d:120ms">Her araç için kullanım alanı, fiyat ve YEK Lab incelemesi. Resmi siteye bağlantı inceleme sayfasının sonunda.</p>
  </section>

  <section class="container">
    <div class="filtreler rule-double filtre-satir" id="filtreler">
      <button class="cip" data-f="kategori" data-v="" aria-pressed="true">Tümü</button>
      {Object.entries(KATEGORILER).map(([id, k]) => (
        <button class="cip" data-f="kategori" data-v={id} aria-pressed="false">{k.ad}</button>
      ))}
      <span class="ayrac" aria-hidden="true"></span>
      <button class="cip" data-f="ucretsiz" data-v="1" aria-pressed="false">Ücretsiz</button>
      <button class="cip" data-f="acik" data-v="1" aria-pressed="false">Açık kaynak</button>
      <span class="ayrac" aria-hidden="true"></span>
      {Object.entries(ZORLUKLAR).map(([id, z]) => (
        <button class="cip" data-f="zorluk" data-v={id} aria-pressed="false">{z.ad}</button>
      ))}
    </div>

    <table class="tablo" id="liste">
      <thead>
        <tr class="kicker">
          <th>Araç</th>
          <th>Ne işe yarar</th>
          <th>Kullanım alanı</th>
          <th>Ücret</th>
          <th>Kaynak</th>
          <th>Seviye</th>
        </tr>
      </thead>
      <tbody>
        {araclar.map((a, i) => (
          <tr
            class="arac reveal"
            style={`--d:${(i % 6) * 40}ms`}
            data-kategori={a.data.kategori}
            data-ucretsiz={a.data.ucretsiz === true ? '1' : '0'}
            data-acik={a.data.acik_kaynak === true ? '1' : '0'}
            data-zorluk={a.data.zorluk}
          >
            <td class="ad">
              <a href={`/araclar/${a.id}/`}>{a.data.ad}</a>
              <span class="kicker muted alan">İncelemeyi gör →</span>
            </td>
            <td class="aciklama">{a.data.aciklama}</td>
            <td><div class="etiketler">{a.data.kullanim.length ? a.data.kullanim.map((k) => <span class="etiket etiket-acik">{k}</span>) : <span class="kicker">{kategoriAdi(a.data.kategori)}</span>}</div></td>
            <td>{a.data.ucretsiz === true ? <span class="etiket">Ücretsiz</span> : a.data.ucretsiz === false ? <span class="etiket etiket-outline">Ücretli</span> : <span class="muted">—</span>}</td>
            <td>{a.data.acik_kaynak === true ? <span class="etiket etiket-outline">Açık</span> : a.data.acik_kaynak === false ? <span class="muted">Kapalı</span> : <span class="muted">—</span>}</td>
            <td class="kicker">{zorlukAdi(a.data.zorluk)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="bos" id="bos" hidden>Bu filtreyle eşleşen araç yok.</p>
  </section>

  <script>
    const cipler = [...document.querySelectorAll<HTMLButtonElement>('#filtreler .cip')];
    const ogeler = [...document.querySelectorAll<HTMLElement>('#liste .arac')];
    const bos = document.getElementById('bos');
    const durum: Record<string, string> = { kategori: '', ucretsiz: '', acik: '', zorluk: '' };
    function uygula() {
      let n = 0;
      ogeler.forEach((a) => {
        const ok =
          (!durum.kategori || a.dataset.kategori === durum.kategori) &&
          (!durum.ucretsiz || a.dataset.ucretsiz === '1') &&
          (!durum.acik || a.dataset.acik === '1') &&
          (!durum.zorluk || a.dataset.zorluk === durum.zorluk);
        a.hidden = !ok;
        if (ok) n++;
      });
      if (bos) bos.hidden = n > 0;
    }
    cipler.forEach((c) =>
      c.addEventListener('click', () => {
        const f = c.dataset.f!;
        const v = c.dataset.v ?? '';
        if (f === 'kategori' || f === 'zorluk') {
          durum[f] = durum[f] === v && f === 'zorluk' ? '' : v;
          cipler.filter((x) => x.dataset.f === f).forEach((x) => x.setAttribute('aria-pressed', String(x === c && durum[f] === v)));
          if (f === 'kategori' && !v) c.setAttribute('aria-pressed', 'true');
        } else {
          durum[f] = durum[f] ? '' : v;
          c.setAttribute('aria-pressed', String(Boolean(durum[f])));
        }
        uygula();
      }),
    );
  </script>

  <style>
    .sayfa-bas {
      padding-bottom: 1.5rem;
    }
    .sayfa-bas h1 {
      font-size: clamp(2.4rem, 5vw, 4.2rem);
    }
    .sayfa-bas em {
      font-style: italic;
      color: var(--accent);
    }
    .giris {
      max-width: 60ch;
      margin: 0;
    }
    .filtre-satir {
      padding-top: 0.8rem;
      padding-bottom: 0.8rem;
      border-bottom: 1px solid var(--rule);
    }
    .tablo {
      width: 100%;
      border-collapse: collapse;
      margin-top: 0.5rem;
    }
    .tablo th {
      text-align: left;
      font-weight: 400;
      padding: 0.8rem 0.8rem 0.5rem 0;
      border-bottom: 1px solid var(--ink);
    }
    .tablo td {
      padding: 1rem 0.8rem 1rem 0;
      border-bottom: 1px solid var(--rule);
      vertical-align: top;
    }
    .ad a {
      font-family: var(--font-display);
      font-size: 1.5rem;
      line-height: 1;
      white-space: nowrap;
    }
    .ad a:hover {
      color: var(--accent);
    }
    .ok {
      font-size: 0.8em;
    }
    .alan {
      display: block;
      margin-top: 0.2rem;
    }
    .aciklama {
      color: var(--ink-2);
      max-width: 42ch;
    }
    .tablo tr.reveal {
      transform: none;
    }
    @media (max-width: 800px) {
      .tablo thead {
        display: none;
      }
      .tablo tr {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.3rem 0.8rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--rule);
      }
      .tablo td {
        border: 0;
        padding: 0;
      }
      .tablo td.ad,
      .tablo td.aciklama {
        grid-column: 1 / -1;
      }
    }
  </style>
</Base>
