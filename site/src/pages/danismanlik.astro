---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bulten from '../components/Bulten.astro';
import { SITE, kartYolu } from '../lib/site';

const kartlar = (await getCollection('kartlar')).sort((a, b) => a.data.sira - b.data.sira).slice(0, 4);
const hizmetler = [
  {
    ad: 'Ekip eğitimi',
    kime: 'Prodüksiyon, pazarlama ve içerik ekipleri',
    metin:
      'Yarım gün ya da iki günlük atölye: ekibiniz kendi işleri üzerinde görsel, video ve metin üretimini; Claude ile dosya, kurgu ve takvim otomasyonunu uygulayarak öğrenir. Sunum değil, çalışma.',
  },
  {
    ad: 'İş akışı kurulumu',
    kime: 'Tekrar eden üretim işi olan şirketler',
    metin:
      'Mevcut sürecinizi haritalar, hangi adımların yapay zekâya devredilebileceğini ölçer, kurar ve ekibinize teslim ederiz. Örnek: 40 ürün videosunun aynı şablondan otomatik üretilmesi, sosyal medya paylaşımının zamanlanması.',
  },
  {
    ad: 'Konuşma ve panel',
    kime: 'Etkinlikler, üniversiteler, şirket içi toplantılar',
    metin:
      'Yapay zekânın prodüksiyonu nasıl değiştirdiğini gerçek örneklerle, korkutmadan ve abartmadan anlatan 30–60 dakikalık konuşmalar. İçerik her seferinde o haftanın gelişmeleriyle güncellenir.',
  },
];
---

<Base title="Danışmanlık ve konuşma" description="YEK Lab: prodüksiyon ekipleri ve şirketler için yapay zekâ iş akışı kurulumu, ekip eğitimi ve konuşmalar. 12 yıllık sinema ve post-prodüksiyon deneyimiyle.">
  <section class="container section sayfa-bas">
    <p class="kicker kicker-accent reveal">YEK Lab · Danışmanlık</p>
    <h1 class="reveal" style="--d:60ms">Ekibinize yapay zekâyı korkutmadan kurmak.</h1>
    <p class="lead giris reveal" style="--d:120ms">
      YEK Lab, {SITE.kurucu}'ın 12 yıllık sinema ve post-prodüksiyon deneyimini yapay zekâ araçlarıyla birleştiren bir
      laboratuvar. Bu sitede her gün yayınlanan gündem, model sıralaması ve iş akışları, şirketlerle yaptığımız işin
      kamuya açık kısmı.
    </p>
  </section>

  <section class="container" id="konusma">
    <div class="cols" style="--n:3">
      {hizmetler.map((h, i) => (
        <article class="kart hizmet reveal" style={`--d:${i * 70}ms`}>
          <span class="kicker">{h.kime}</span>
          <h2>{h.ad}</h2>
          <p>{h.metin}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div>
        <p class="kicker kicker-accent">Vaka analizleri</p>
        <h2>Kurduğumuz iş akışları</h2>
      </div>
      <a href="/bilmeniz-gerekenler/" class="more">Tüm iş akışları →</a>
    </div>
    <div class="vakalar">
      {kartlar.map((k) => (
        <a href={kartYolu(k.id)} class="vaka reveal">
          <span class="kicker">{String(k.data.sira).padStart(2, '0')}</span>
          <span class="vaka-ad">{k.data.baslik}</span>
          <span class="vaka-ozet">{k.data.ozet}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section" style="padding-top:0">
    <div class="kurucu kart reveal">
      <div class="kurucu-ic">
        <p class="kicker">Kurucu</p>
        <h2>{SITE.kurucu}</h2>
        <p>
          On iki yıl sinema ve post-prodüksiyonda çalıştı: kurgu, renk, motion graphics, teslim hattı. Son iki yılda bu
          hattın her adımını yapay zekâ araçlarıyla yeniden kurdu ve aynı dönüşümü şirketlere ve ekiplere taşıyor. Bu
          sitedeki her "YEK Lab analizi" kendi denemelerine dayanır; denemediğini denemiş gibi yazmaz.
        </p>
        <div class="iletisim">
          {SITE.iletisimEposta && <a href={`mailto:${SITE.iletisimEposta}`} class="btn btn-ink">{SITE.iletisimEposta}</a>}
          <a href={SITE.instagram} class:list={['btn', { 'btn-ink': !SITE.iletisimEposta }]} target="_blank" rel="noopener">Instagram'dan yazın: {SITE.instagramKullanici}</a>
        </div>
        <p class="muted small" style="margin:0.8rem 0 0">Konuşma ve danışmanlık davetleri için ilk görüşme ücretsizdir.</p>
      </div>
    </div>
  </section>

  <section class="container" style="padding-bottom:2rem">
    <Bulten />
  </section>
</Base>

<style>
  .sayfa-bas {
    padding-bottom: 1.5rem;
  }
  .sayfa-bas h1 {
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    max-width: 18ch;
  }
  .giris {
    max-width: 66ch;
    margin: 0;
  }
  .hizmet {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.5rem 1.5rem;
  }
  .hizmet h2 {
    margin: 0;
    font-size: 1.7rem;
  }
  .hizmet p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .vakalar {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 760px) {
    .vakalar {
      grid-template-columns: 1fr;
    }
  }
  .vaka {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
    transition: border-color 0.25s var(--ease);
  }
  .vaka:hover {
    border-color: var(--accent);
  }
  .vaka-ad {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.15;
  }
  .vaka-ozet {
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .kurucu {
    padding: clamp(1.5rem, 4vw, 2.6rem);
  }
  .kurucu-ic {
    max-width: 720px;
  }
  .kurucu h2 {
    margin: 0.3rem 0 0.6rem;
    font-size: 2rem;
  }
  .kurucu p {
    color: var(--ink-2);
    font-size: 1.02rem;
    line-height: 1.55;
  }
  .iletisim {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }
</style>
