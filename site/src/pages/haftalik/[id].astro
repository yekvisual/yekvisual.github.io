---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Bulten from '../../components/Bulten.astro';
import { tarihTR } from '../../lib/site';

export async function getStaticPaths() {
  const ozetler = await getCollection('ozetler');
  return ozetler.map((ozet) => ({ params: { id: ozet.id }, props: { ozet } }));
}
const { ozet } = Astro.props;
const { Content } = await render(ozet);
---

<Base title={ozet.data.baslik} description={ozet.data.ozet} type="article" tarih={ozet.data.tarih} image={`/og/ozet/${ozet.id}.png`}>
  <article class="container section yazi">
    <a href="/haftalik/" class="kicker geri">← Haftalık özetler</a>
    <p class="kicker kicker-accent reveal">Pazar eki · <time datetime={ozet.data.tarih.toISOString()}>{tarihTR(ozet.data.tarih)}</time></p>
    <h1 class="display reveal" style="--d:60ms">{ozet.data.baslik}</h1>
    <p class="lead reveal" style="--d:120ms">{ozet.data.ozet}</p>
    <div class="prose dropcap reveal rule" style="--d:180ms"><Content /></div>
  </article>
  <section class="container" style="padding-bottom:2rem">
    <Bulten />
  </section>
</Base>

<style>
  .yazi {
    max-width: 800px;
  }
  .geri {
    display: inline-block;
    margin-bottom: 1rem;
  }
  .geri:hover {
    color: var(--accent);
  }
  .yazi h1 {
    text-transform: none;
    font-size: clamp(2.4rem, 5.5vw, 4.6rem);
  }
  .prose {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
  }
</style>
