---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BilgiKart from '../../components/BilgiKart.astro';

const kartlar = (await getCollection('kartlar')).sort((a, b) => a.data.sira - b.data.sira);
---

<Base title="İş Akışları" description="Prodüksiyon ve içerik ekipleri için yapay zekâ iş akışları: ne yapar, nasıl kurulur, ilk adım ne." image="/og/kart/liste.png">
  <section class="container section sayfa-bas">
    <p class="kicker kicker-accent reveal">İş akışları & otomasyon · {kartlar.length} vaka</p>
    <h1 class="reveal" style="--d:60ms">Hafta sonu laboratuvarı</h1>
    <p class="lead giris reveal" style="--d:120ms">
      Her kart, kendi işimizde kurup denediğimiz bir iş akışını anlatır: ne yapar, kimin işine yarar, ilk adım nedir. Hepsi
      bir hafta sonunda kurulabilir; araçların çoğu ücretsiz.
    </p>
  </section>
  <section class="container" style="padding-bottom:2rem">
    <div class="cols izgara rule" style="--n:4">
      {kartlar.map((k, i) => <div><BilgiKart kart={k} gecikme={(i % 4) * 70} /></div>)}
    </div>
  </section>
</Base>

<style>
  .sayfa-bas {
    padding-bottom: 1.5rem;
  }
  .sayfa-bas h1 {
    font-size: clamp(2.4rem, 5vw, 4.2rem);
  }
  .giris {
    max-width: 62ch;
    margin: 0;
  }
  .izgara {
    padding-top: 0;
  }
  .izgara > div {
    padding-block: 1.8rem;
    display: flex;
  }
</style>
