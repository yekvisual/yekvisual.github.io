---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BilgiKart from '../../components/BilgiKart.astro';

const kartlar = (await getCollection('kartlar')).sort((a, b) => a.data.sira - b.data.sira);
---

<Base title="Bilmeniz Gerekenler" description="Yapay zekâ ile görsel, video ve içerik üretimine sıfırdan başlayanlar için: bugün neler mümkün, nereden başlanır." image="/og/kart/liste.png">
  <section class="container section sayfa-bas">
    <p class="kicker kicker-accent reveal">Sıfırdan başlayanlar için · {kartlar.length} kart</p>
    <h1 class="display reveal" style="--d:60ms">Bilmeniz<br />gerekenler</h1>
    <p class="lead giris reveal" style="--d:120ms">
      Bugün yapay zekâyla nelerin mümkün olduğunu bilmeden "nereden başlasam?" sorusu cevaplanmıyor. Her kart tek bir
      şeyi anlatır: ne bu, ne işe yarar, ilk adım ne. Sırayla oku ya da ilgini çekenden başla.
    </p>
  </section>
  <section class="container" style="padding-bottom:2rem">
    <div class="cols izgara rule" style="--n:4">
      {kartlar.map((k, i) => <div><BilgiKart kart={k} gecikme={(i % 4) * 70} /></div>)}
    </div>
  </section>
</Base>

<style>
  .sayfa-bas {
    padding-bottom: 1.5rem;
  }
  .sayfa-bas h1 {
    font-size: clamp(2.4rem, 5vw, 4.2rem);
  }
  .giris {
    max-width: 62ch;
    margin: 0;
  }
  .izgara {
    padding-top: 0;
  }
  .izgara > div {
    padding-block: 1.8rem;
    display: flex;
  }
</style>
