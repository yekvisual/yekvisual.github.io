---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HaberKart from '../../components/HaberKart.astro';
import Rozetler from '../../components/Rozetler.astro';
import { kartYolu } from '../../lib/site';

export async function getStaticPaths() {
  const kartlar = await getCollection('kartlar');
  return kartlar.map((kart) => ({ params: { id: kart.id }, props: { kart } }));
}

const { kart } = Astro.props;
const d = kart.data;
const { Content } = await render(kart);

const tumKartlar = (await getCollection('kartlar')).sort((a, b) => a.data.sira - b.data.sira);
const i = tumKartlar.findIndex((k) => k.id === kart.id);
const onceki = tumKartlar[i - 1];
const sonraki = tumKartlar[i + 1];
const araclar = (await getCollection('araclar')).filter((a) => d.araclar.includes(a.id));
const haberler = (await getCollection('haberler'))
  .filter((h) => h.data.kart === kart.id || h.data.kategori === d.kategori)
  .sort((a, b) => b.data.tarih.valueOf() - a.data.tarih.valueOf())
  .slice(0, 3);
---

<Base title={d.baslik} description={d.ozet} image={`/og/kart/${kart.id}.png`}>
  <article class="container section kart-sayfa">
    <header class="bas rule-double">
      <div class="bas-sol">
        <span class="display no">{String(d.sira).padStart(2, '0')}</span>
        <span class="kicker">/ {String(tumKartlar.length).padStart(2, '0')}</span>
      </div>
      <div class="bas-orta reveal">
        <p class="kicker kicker-accent">İş akışı · vaka analizi</p>
        <h1>{d.baslik}</h1>
        <p class="lead">{d.ozet}</p>
        <Rozetler kategori={d.kategori} zorluk={d.zorluk} />
      </div>
      <div class="bas-sag" aria-hidden="true">{d.ikon}</div>
    </header>

    {d.gorsel && (
      <div class="kapak reveal-img hero-gorsel">
        <Image src={d.gorsel} alt="" width={1400} widths={[800, 1200, 1600]} sizes="100vw" loading="eager" />
      </div>
    )}

    <div class="govde">
      <div class="prose dropcap reveal" style="--d:100ms">
        <Content />
      </div>
      <aside class="yan reveal" style="--d:200ms">
        {araclar.length > 0 && (
          <div class="kutu">
            <p class="kutu-baslik">Araçlar</p>
            <ul class="arac-listesi">
              {araclar.map((a) => (
                <li>
                  <a href={a.data.url} target="_blank" rel="noopener">{a.data.ad} ↗</a>
                  <span class="small muted">{a.data.aciklama}</span>
                </li>
              ))}
            </ul>
            <a href="/araclar/" class="kicker">Tüm araçlar →</a>
          </div>
        )}
        <nav class="gezin">
          {onceki && (
            <a href={kartYolu(onceki.id)}>
              <span class="kicker">← Önceki</span>
              <span>{onceki.data.baslik}</span>
            </a>
          )}
          {sonraki && (
            <a href={kartYolu(sonraki.id)}>
              <span class="kicker">Sonraki →</span>
              <span>{sonraki.data.baslik}</span>
            </a>
          )}
        </nav>
      </aside>
    </div>

    {haberler.length > 0 && (
      <section class="ilgili">
        <div class="section-head">
          <h2 class="display">Bu konuda son gelişmeler</h2>
          <a href={`/gundem/kategori/${d.kategori}/`} class="more">Kategorideki tüm haberler</a>
        </div>
        <div class="cols" style="--n:3">{haberler.map((h, i) => <div><HaberKart haber={h} gecikme={i * 90} /></div>)}</div>
      </section>
    )}
  </article>
</Base>

<style>
  .bas {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    align-items: start;
    padding-top: 1.4rem;
    margin-bottom: 2.5rem;
  }
  .bas-sol {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .no {
    font-size: clamp(3.5rem, 7vw, 6rem);
    line-height: 0.9;
  }
  .bas-orta h1 {
    font-size: clamp(2.6rem, 5.5vw, 4.8rem);
    text-transform: none;
  }
  .bas-orta .lead {
    max-width: 58ch;
  }
  .bas-sag {
    font-size: 3rem;
    filter: grayscale(1) contrast(1.2);
  }
  .hero-gorsel {
    aspect-ratio: 21 / 9;
    margin-bottom: 2.5rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .govde {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .govde {
      grid-template-columns: minmax(0, 1fr) 300px;
    }
  }
  @media (max-width: 700px) {
    .bas {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .bas-sol {
      flex-direction: row;
      gap: 0.6rem;
      align-items: baseline;
    }
    .bas-sag {
      display: none;
    }
  }
  .yan {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    align-self: start;
    position: sticky;
    top: 1.5rem;
  }
  .arac-listesi {
    list-style: none;
    padding: 0;
    margin: 0 0 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .arac-listesi a {
    font-family: var(--font-display);
    font-size: 1.2rem;
    display: block;
    line-height: 1.1;
  }
  .arac-listesi a:hover {
    color: var(--accent);
  }
  .gezin {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--ink);
  }
  .gezin a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.1;
  }
  .gezin a:hover {
    color: var(--accent);
  }
  .ilgili {
    margin-top: 4rem;
  }
</style>
