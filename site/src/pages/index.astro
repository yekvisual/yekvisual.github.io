---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import HaberKart from '../components/HaberKart.astro';
import BilgiKart from '../components/BilgiKart.astro';
import Bulten from '../components/Bulten.astro';
import ModelPaneli from '../components/ModelPaneli.astro';
import { SITE } from '../lib/site';
import reelKling from '../assets/reels/kling-4.jpg';
import reelKimi from '../assets/reels/kimi-3-1.jpg';
import reelDiyalog from '../assets/reels/kling-4-diyalog.jpg';
import giris from '../../../content/site/giris.json';
import instagram from '../data/instagram.json';

const haberler = (await getCollection('haberler')).sort((a, b) => b.data.tarih.valueOf() - a.data.tarih.valueOf());
const kartlar = (await getCollection('kartlar')).sort((a, b) => a.data.sira - b.data.sira);
const araclar = (await getCollection('araclar')).sort((a, b) => b.data.populer - a.data.populer || a.data.ad.localeCompare(b.data.ad, 'tr'));

const manset = haberler.find((h) => h.data.puan >= 5) ?? haberler[0];
const digerleri = haberler.filter((h) => h !== manset);
const altikiKucuk = digerleri.slice(0, 2);
const bugun = haberler.slice(0, 7);
const oneCikanAraclar = araclar.slice(0, 4);

// Giriş metni: başlangıç tarihinden itibaren her hafta sıradaki cümle
const haftaNo = Math.max(0, Math.floor((Date.now() - new Date(giris.baslangic).valueOf()) / (7 * 86400000)));
const girisMetni = giris.metinler[haftaNo % giris.metinler.length];

// Instagram: build öncesi scripts/instagram.mjs gerçek paylaşımları yazar; yoksa kendi karelerimiz
type Reel = { gorsel: ImageMetadata | string; etiket: string; href: string };
const yedekReels: Reel[] = [
  { gorsel: reelKling, etiket: 'Kling 4.0 çıktı', href: SITE.instagram },
  { gorsel: reelKimi, etiket: 'Kimi K3.1 evde çalışır mı?', href: SITE.instagram },
  { gorsel: reelDiyalog, etiket: '30 sn tek çekim, Türkçe diyalog', href: SITE.instagram },
];
const reels: Reel[] = instagram.length >= 3 ? instagram.slice(0, 3).map((p) => ({ gorsel: p.gorsel, etiket: p.baslik, href: p.permalink })) : yedekReels;
---

<Base>
  <!-- Giriş -->
  <section class="giris" id="ust">
    <div class="gunes" id="gunes" aria-hidden="true"></div>
    <div class="container giris-ic">
      <h1 class="reveal">{giris.baslik}</h1>
      <p class="lead giris-aciklama reveal" style="--d:80ms">{girisMetni}</p>
      <div class="cipler reveal" style="--d:140ms">
        <a href="/gundem/kategori/gorsel/" class="cip-renk" style="--c:#ffefb3;--t:#7a4b00">görsel</a>
        <a href="/gundem/kategori/video/" class="cip-renk" style="--c:#e3ebf6;--t:#1f3a5f">video</a>
        <a href="/gundem/kategori/ses/" class="cip-renk" style="--c:#fbe4e8;--t:#9b2c4a">ses</a>
        <a href="/gundem/kategori/otomasyon/" class="cip-renk" style="--c:#fde3c8;--t:#8a3d00">otomasyon</a>
        <a href="/gundem/kategori/acik-kaynak/" class="cip-renk" style="--c:#ebe6f5;--t:#4a3a86">açık kaynak</a>
      </div>
      {SITE.bultenFormUrl && (
        <form action={SITE.bultenFormUrl} method="post" target="_blank" class="giris-form reveal" style="--d:200ms">
          <label class="sr-only" for="giris-email">E-posta adresiniz</label>
          <input id="giris-email" type="email" name="email" placeholder="E-posta adresinizi girin" autocomplete="email" required />
          <button class="btn btn-ink" type="submit">Bültene katıl</button>
        </form>
      )}
      <p class="giris-not reveal" style="--d:240ms">Her Cumartesi 14:00'te haftanın özeti.</p>
    </div>
  </section>

  <!-- Model paneli -->
  <section class="container panel-alani">
    <ModelPaneli varsayilan="video" />
  </section>

  <!-- Ana yazı + Bugün -->
  <section class="container section bugun-alani" id="bugun">
    <div class="ana">
      {manset && <HaberKart haber={manset} boyut="manset" />}
      {altikiKucuk.length > 0 && (
        <div class="alt-iki">
          {altikiKucuk.map((h, i) => <HaberKart haber={h} boyut="kucuk" gecikme={i * 90} />)}
        </div>
      )}
    </div>
    <aside class="yan">
      <div class="yan-bas">
        <h2>Bugün</h2>
        <a href="/gundem/" class="more">Tüm gündem →</a>
      </div>
      {bugun.length ? (
        <div class="satirlar">{bugun.map((h, i) => <HaberKart haber={h} boyut="satir" gecikme={i * 50} />)}</div>
      ) : (
        <p class="bos">İlk haberler yolda.</p>
      )}
    </aside>
  </section>

  <!-- Bilmeniz gerekenler -->
  <section class="container section" id="basla">
    <div class="section-head">
      <div>
        <p class="kicker kicker-accent">İş akışları &amp; otomasyon</p>
        <h2>Hafta sonu laboratuvarı</h2>
      </div>
      <a href="/bilmeniz-gerekenler/" class="more">{kartlar.length} iş akışının tamamı →</a>
    </div>
    <div class="cols" style="--n:4">
      {kartlar.slice(0, 4).map((k, i) => <BilgiKart kart={k} gecikme={i * 70} />)}
    </div>
  </section>

  <!-- Araçlar -->
  <section class="container section" id="araclar">
    <div class="section-head">
      <div>
        <p class="kicker kicker-accent">Araç dizini</p>
        <h2>Hangi iş için hangi araç?</h2>
      </div>
      <a href="/araclar/" class="more">{araclar.length} aracın tamamı →</a>
    </div>
    <div class="cols" style="--n:4">
      {oneCikanAraclar.map((a, i) => (
        <a href={`/araclar/${a.id}/`} class="arac kart reveal" style={`--d:${i * 70}ms`}>
          <div class="etiketler">
            {a.data.kullanim.slice(0, 2).map((k) => <span class="etiket etiket-acik">{k}</span>)}
            {a.data.ucretsiz === true && <span class="etiket etiket-ucretsiz">Ücretsiz</span>}
            {a.data.acik_kaynak === true && <span class="etiket etiket-ucretsiz">Açık kaynak</span>}
          </div>
          <strong>{a.data.ad}</strong>
          <p>{a.data.aciklama}</p>
          <span class="arac-link">YEK Lab incelemesi →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Kurucu / Lab notu -->
  <section class="container section" style="padding-bottom:0">
    <div class="kurucu kart reveal">
      <div class="kurucu-metin">
        <p class="kicker">Kurucu · Lab notu</p>
        <h2>{SITE.kurucu}: 12 yıl sinema ve post-prodüksiyon, iki yıldır yapay zekâ ile.</h2>
        <p>
          Kurgu, renk ve teslim hattını yapay zekâ araçlarıyla yeniden kurdum; aynı dönüşümü şirketlere ve ekiplere
          taşıyorum. Bu sitedeki her analiz kendi denemelerime dayanır.
        </p>
      </div>
      <div class="kurucu-eylem">
        <a href="/danismanlik/" class="btn btn-ink">Ekibiniz için danışmanlık</a>
        <a href="/danismanlik/#konusma" class="btn">Konuşmacı daveti</a>
      </div>
    </div>
  </section>

  <!-- Bülten + Instagram -->
  <section class="container section son">
    <Bulten />
    <div class="ig kart reveal" style="--d:80ms">
      <div class="ig-bas">
        <div>
          <p class="kicker">Instagram</p>
          <h2>{SITE.instagramKullanici}</h2>
        </div>
        <a href={SITE.instagram} target="_blank" rel="noopener" class="more">Takip et →</a>
      </div>
      <div class="reels">
        {reels.map((r) => (
          <a href={r.href} target="_blank" rel="noopener" class="reel">
            {typeof r.gorsel === 'string' ? <img src={r.gorsel} alt={r.etiket} loading="lazy" /> : <Image src={r.gorsel} alt={r.etiket} width={360} loading="lazy" />}
            <span>{r.etiket}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  // Giriş halkası: fare merkeze yaklaştıkça büyür ve parlar; hep ortada kalır.
  const gunes = document.getElementById('gunes');
  const ust = document.getElementById('ust');
  const azHareket = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (gunes && ust && !azHareket && matchMedia('(pointer: fine)').matches) {
    let raf = 0;
    let son = 0;
    window.addEventListener(
      'mousemove',
      (e) => {
        const r = ust.getBoundingClientRect();
        if (r.bottom < 0) return;
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const d = Math.hypot(e.clientX - cx, e.clientY - cy);
        const yakin = Math.max(0, 1 - d / Math.max(420, r.height * 0.9));
        if (Math.abs(yakin - son) < 0.01 || raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          son = yakin;
          gunes.style.setProperty('--olcek', (0.8 + yakin * 0.6).toFixed(3));
          gunes.style.setProperty('--opak', (0.62 + yakin * 0.3).toFixed(2));
          gunes.style.setProperty('--doygun', (1 + yakin * 0.35).toFixed(2));
        });
      },
      { passive: true },
    );
  }
</script>

<style>
  .giris {
    position: relative;
    overflow: hidden;
    z-index: 0;
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(2.4rem, 4vw, 3.6rem);
    text-align: center;
  }
  .gunes {
    --olcek: 1;
    --opak: 0.78;
    --doygun: 1;
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(600px, 120vw);
    height: min(600px, 120vw);
    margin: calc(min(600px, 120vw) / -2) 0 0 calc(min(600px, 120vw) / -2);
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(closest-side, #fff4b0 0%, #ffd43b 26%, #ff9f1c 52%, #ff7a45 68%, rgba(251, 250, 248, 0) 82%);
    opacity: var(--opak);
    filter: blur(6px) saturate(var(--doygun));
    transform: scale(var(--olcek));
    transition: transform 0.3s ease-out, opacity 0.3s ease-out, filter 0.3s ease-out;
    will-change: transform;
  }
  .giris-ic {
    position: relative;
    z-index: 1;
  }
  .giris h1 {
    margin: 0 auto;
    max-width: 16ch;
    font-size: clamp(2.6rem, 6.4vw, 5.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .giris-aciklama {
    margin: 1.4rem auto 0;
    max-width: 58ch;
  }
  .cipler {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.3rem;
  }
  .cip-renk {
    display: inline-flex;
    align-items: center;
    height: 1.8rem;
    padding: 0 0.8rem;
    border-radius: 999px;
    background: var(--c);
    color: var(--t);
    font-size: 0.85rem;
    font-weight: 500;
    transition: transform 0.2s var(--ease);
  }
  .cip-renk:hover {
    transform: translateY(-1px);
  }
  .giris-form {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin: 2rem auto 0;
    max-width: 520px;
  }
  .giris-form input {
    flex: 1 1 240px;
    height: 3rem;
    padding: 0 1.1rem;
    font: inherit;
    font-size: 0.98rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--bg-2);
    color: var(--ink);
    box-shadow: var(--golge);
  }
  .giris-form input::placeholder {
    color: var(--muted);
  }
  .giris-form .btn {
    height: 3rem;
    padding: 0 1.4rem;
    font-size: 0.95rem;
  }
  .giris-not {
    margin: 0.7rem 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .panel-alani {
    position: relative;
    z-index: 1;
    margin-top: 0.6rem;
  }

  .bugun-alani {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(300px, 4fr);
    gap: 3rem;
  }
  .ana {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    min-width: 0;
  }
  .alt-iki {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .yan {
    min-width: 0;
  }
  .yan-bas {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.8rem;
  }
  .yan-bas h2 {
    margin: 0;
    font-size: 1.6rem;
  }
  .yan-bas .more {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
  }
  @media (max-width: 960px) {
    .bugun-alani {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  @media (max-width: 560px) {
    .alt-iki {
      grid-template-columns: 1fr;
    }
  }

  .arac {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.1rem 1.1rem;
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .arac:hover {
    border-color: var(--line-2);
    transform: translateY(-2px);
  }
  .arac-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: 0.2rem;
  }
  .arac strong {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
  }
  .arac p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-2);
    line-height: 1.45;
    flex: 1;
  }

  .kurucu {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    padding: clamp(1.4rem, 3vw, 2.2rem);
  }
  .kurucu-metin {
    max-width: 640px;
  }
  .kurucu-metin h2 {
    margin: 0.3rem 0 0.5rem;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-weight: 400;
  }
  .kurucu-metin p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  .kurucu-eylem {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 0 0 auto;
  }
  .son {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 860px) {
    .son {
      grid-template-columns: 1fr;
    }
  }
  .ig {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .ig-bas {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .ig-bas h2 {
    margin: 0.2rem 0 0;
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    font-weight: 400;
  }
  .ig-bas .more {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }
  .reels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .reel {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 6px;
    overflow: hidden;
    background: var(--ink);
  }
  .reel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .reel:hover img {
    transform: scale(1.04);
  }
  .reel span {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.6rem 0.7rem 0.7rem;
    background: linear-gradient(180deg, rgba(27, 26, 24, 0), rgba(27, 26, 24, 0.75));
    color: var(--bg);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
  }
</style>
