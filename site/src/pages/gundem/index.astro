---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HaberKart from '../../components/HaberKart.astro';
import { KATEGORILER } from '../../lib/taxonomy';

const haberler = (await getCollection('haberler')).sort((a, b) => b.data.tarih.valueOf() - a.data.tarih.valueOf());
---

<Base title="Gündem" description="Yapay zekâ görsel, video, ses ve otomasyon dünyasından yeni modeller, araçlar ve gelişmeler. Türkçe, güncel.">
  <section class="container section sayfa-bas">
    <p class="kicker kicker-accent reveal">Gündem · {haberler.length} haber</p>
    <h1 class="display reveal" style="--d:60ms">Yeni çıkanlar,<br /><em>sade anlatım.</em></h1>
    <p class="lead giris reveal" style="--d:120ms">Her gün taranan onlarca kaynaktan süzülen gelişmeler. Yalnızca ne işine yarayacağı belli olanlar.</p>
  </section>

  <section class="container">
    <div class="filtreler rule-double filtre-satir" id="filtreler" role="group" aria-label="Filtreler">
      <button class="cip" data-f="kategori" data-v="" aria-pressed="true">Tümü</button>
      {Object.entries(KATEGORILER).map(([id, k]) => (
        <button class="cip" data-f="kategori" data-v={id} aria-pressed="false">{k.ad}</button>
      ))}
      <span class="ayrac" aria-hidden="true"></span>
      <button class="cip" data-f="ucretsiz" data-v="1" aria-pressed="false">Ücretsiz</button>
      <button class="cip" data-f="acik" data-v="1" aria-pressed="false">Açık kaynak</button>
    </div>

    {haberler.length ? (
      <div class="cols liste" style="--n:3" id="liste">
        {haberler.map((h, i) => <div><HaberKart haber={h} gecikme={(i % 3) * 90} /></div>)}
      </div>
    ) : null}
    <p class="bos" id="bos" hidden>Bu filtreyle eşleşen haber yok.</p>
  </section>

  <script>
    const liste = document.getElementById('liste');
    const bos = document.getElementById('bos');
    const cipler = [...document.querySelectorAll<HTMLButtonElement>('#filtreler .cip')];
    const durum: Record<string, string> = { kategori: '', ucretsiz: '', acik: '' };

    function uygula() {
      let gorunen = 0;
      liste?.querySelectorAll<HTMLElement>(':scope > div').forEach((kap) => {
        const a = kap.querySelector<HTMLElement>('article')!;
        const ok =
          (!durum.kategori || a.dataset.kategori === durum.kategori) &&
          (!durum.ucretsiz || a.dataset.ucretsiz === '1') &&
          (!durum.acik || a.dataset.acik === '1');
        kap.hidden = !ok;
        if (ok) gorunen++;
      });
      if (bos) bos.hidden = gorunen > 0;
      const url = new URL(location.href);
      durum.kategori ? url.searchParams.set('k', durum.kategori) : url.searchParams.delete('k');
      history.replaceState(null, '', url);
    }

    cipler.forEach((c) => {
      c.addEventListener('click', () => {
        const f = c.dataset.f!;
        const v = c.dataset.v ?? '';
        if (f === 'kategori') {
          durum.kategori = v;
          cipler.filter((x) => x.dataset.f === 'kategori').forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
        } else {
          durum[f] = durum[f] ? '' : v;
          c.setAttribute('aria-pressed', String(Boolean(durum[f])));
        }
        uygula();
      });
    });

    const k = new URLSearchParams(location.search).get('k');
    if (k) cipler.find((c) => c.dataset.f === 'kategori' && c.dataset.v === k)?.click();
  </script>

  <style>
    .sayfa-bas {
      padding-bottom: 1.5rem;
    }
    .sayfa-bas h1 {
      font-size: clamp(2.4rem, 5vw, 4.2rem);
    }
    .sayfa-bas em {
      font-style: italic;
      color: var(--accent);
    }
    .giris {
      max-width: 60ch;
      margin: 0;
    }
    .filtre-satir {
      padding-top: 0.8rem;
      padding-bottom: 0.8rem;
      border-bottom: 1px solid var(--rule);
      margin-bottom: 0.5rem;
    }
    .liste > div {
      padding-block: 1.8rem;
    }
  </style>
</Base>
