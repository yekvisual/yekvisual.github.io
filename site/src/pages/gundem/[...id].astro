---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Kapak from '../../components/Kapak.astro';
import Medya from '../../components/Medya.astro';
import Rozetler from '../../components/Rozetler.astro';
import HaberKart from '../../components/HaberKart.astro';
import { SITE, kartYolu, tarihTR } from '../../lib/site';

export async function getStaticPaths() {
  const haberler = await getCollection('haberler');
  return haberler.map((haber) => ({ params: { id: haber.id }, props: { haber } }));
}

const { haber } = Astro.props;
const d = haber.data;
const { Content } = await render(haber);
const kart = d.kart ? await getEntry('kartlar', d.kart) : undefined;
const ilgili = (await getCollection('haberler'))
  .filter((h) => h.id !== haber.id && (h.data.kategori === d.kategori || h.data.kart === d.kart))
  .sort((a, b) => b.data.tarih.valueOf() - a.data.tarih.valueOf())
  .slice(0, 3);
const ogYolu = `/og/${haber.id}.png`;
const paylasUrl = new URL(Astro.url.pathname, Astro.site).toString();
const yeni = Date.now() - d.tarih.valueOf() < 3 * 86400_000;
---

<Base title={d.baslik} description={d.ozet} image={ogYolu} type="article" tarih={d.tarih}>
  <article class="haber">
    <header class="container bas">
      <div class="bas-ust kicker">
        <a href="/gundem/" class="geri">← Gündem</a>
        <span class="muted">·</span>
        <time datetime={d.tarih.toISOString()}>{tarihTR(d.tarih)}</time>
        {d.sirket && <span class="muted">· {d.sirket}</span>}
        {d.model && <span class="muted">· {d.model}</span>}
      </div>
      <div class="reveal">
        <Rozetler kategori={d.kategori} yeni={yeni} ornek={d.ornek} />
      </div>
      <h1 class="display reveal" style="--d:60ms">{d.baslik}</h1>
      <p class="lead reveal" style="--d:120ms">{d.ozet}</p>
      <div class="reveal" style="--d:160ms">
        <Rozetler ucretsiz={d.ucretsiz} acikKaynak={d.acik_kaynak} zorluk={d.zorluk} />
      </div>
    </header>

    <div class="container kapak-alani">
      <Kapak gorsel={d.kapak} kaynak={d.kapak_kaynak} baslik={d.baslik} kategori={d.kategori} genislik={1400} oncelik oran="21 / 9" />
    </div>

    <div class="container govde">
      <div class="ana">
        {d.neden_onemli && (
          <div class="kutu reveal">
            <p class="kutu-baslik">Neden önemli?</p>
            <p class="son">{d.neden_onemli}</p>
          </div>
        )}

        {d.medya.map((m) => <Medya medya={m} haberId={haber.id} />)}

        <div class="prose dropcap reveal">
          <Content />
        </div>

        {d.yekvisual_notu && (
          <div class="kutu kutu-not reveal">
            <p class="kutu-baslik">yekvisual analizi</p>
            <p class="son">{d.yekvisual_notu}</p>
          </div>
        )}

        {d.denemeler.length > 0 && (
          <section class="denemeler reveal">
            <h2 class="display">Ben denedim</h2>
            {d.denemeler.map((m) => <Medya medya={m} haberId={haber.id} />)}
          </section>
        )}

        {d.kaynaklar.length > 0 && (
          <section class="kaynaklar reveal">
            <p class="kutu-baslik">Kaynaklar</p>
            <ul>
              {d.kaynaklar.map((k) => (
                <li>
                  <a href={k.url} target="_blank" rel="noopener">{k.ad} ↗</a>
                  <span class="muted small">{new URL(k.url).hostname}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {d.etiketler.length > 0 && (
          <div class="etiketler reveal">
            {d.etiketler.map((e) => <span class="etiket etiket-ince">#{e}</span>)}
          </div>
        )}
      </div>

      <aside class="yan reveal" style="--d:200ms">
        {kart && (
          <a href={kartYolu(kart.id)} class="kutu kart-link">
            <p class="kutu-baslik">Başlangıç kartı {String(kart.data.sira).padStart(2, '0')}</p>
            <strong class="kart-baslik">{kart.data.baslik}</strong>
            <span class="muted small">{kart.data.ozet}</span>
          </a>
        )}
        <div class="kutu">
          <p class="kutu-baslik">Paylaş</p>
          <div class="paylas">
            <a class="btn" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(d.baslik)}&url=${encodeURIComponent(paylasUrl)}`} target="_blank" rel="noopener">X</a>
            <a class="btn" href={`https://wa.me/?text=${encodeURIComponent(d.baslik + ' ' + paylasUrl)}`} target="_blank" rel="noopener">WhatsApp</a>
            <button class="btn" id="kopyala" type="button">Kopyala</button>
          </div>
        </div>
        <a href={SITE.instagram} class="btn btn-ink ig" target="_blank" rel="noopener">Instagram'da takip et</a>
      </aside>
    </div>

    {ilgili.length > 0 && (
      <section class="container ilgili">
        <div class="section-head">
          <h2 class="display">İlgili haberler</h2>
        </div>
        <div class="cols">{ilgili.map((h, i) => <div><HaberKart haber={h} gecikme={i * 90} /></div>)}</div>
      </section>
    )}
  </article>

  <script>
    document.getElementById('kopyala')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(location.href);
        b.textContent = 'Kopyalandı';
        setTimeout(() => (b.textContent = 'Kopyala'), 1500);
      } catch {}
    });
  </script>

  <style>
    .bas {
      padding-top: 2rem;
      max-width: 960px;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }
    .bas-ust {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .geri:hover {
      color: var(--accent);
    }
    .bas h1 {
      font-size: clamp(2.4rem, 5.6vw, 4.8rem);
      text-transform: none;
      margin: 0;
    }
    .bas .lead {
      margin: 0;
      max-width: 60ch;
    }
    .kapak-alani {
      margin-top: 2rem;
    }
    .kapak-alani :global(.kapak-baslik) {
      font-size: clamp(3rem, 8vw, 7rem);
    }
    .govde {
      display: grid;
      gap: 2.5rem;
      grid-template-columns: minmax(0, 1fr);
      margin-top: 2.5rem;
    }
    @media (min-width: 960px) {
      .govde {
        grid-template-columns: minmax(0, 1fr) 300px;
      }
    }
    .ana {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
      max-width: 720px;
    }
    .son {
      margin: 0;
    }
    .denemeler h2 {
      border-top: 1px solid var(--ink);
      padding-top: 0.5rem;
    }
    .kaynaklar ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      border-top: 1px solid var(--ink);
      padding-top: 0.6rem;
    }
    .kaynaklar a {
      font-family: var(--font-display);
      font-size: 1.2rem;
    }
    .kaynaklar a:hover {
      color: var(--accent);
    }
    .yan {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-self: start;
      position: sticky;
      top: 1.5rem;
    }
    .kart-link {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      transition: background 0.3s var(--ease);
    }
    .kart-link:hover {
      background: var(--paper-2);
    }
    .kart-baslik {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 1.4rem;
      line-height: 1.05;
    }
    .paylas {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .paylas .btn {
      padding: 0.5rem 0.9rem 0.42rem;
      font-size: 0.8rem;
    }
    .ig {
      justify-content: center;
    }
    .ilgili {
      margin-top: 4rem;
    }
  </style>
</Base>
