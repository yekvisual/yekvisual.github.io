---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import HaberKart from '../../../components/HaberKart.astro';
import { KATEGORILER } from '../../../lib/taxonomy';

export async function getStaticPaths() {
  return Object.keys(KATEGORILER).map((kategori) => ({ params: { kategori } }));
}

const { kategori } = Astro.params;
const k = KATEGORILER[kategori];
const haberler = (await getCollection('haberler'))
  .filter((h) => h.data.kategori === kategori)
  .sort((a, b) => b.data.tarih.valueOf() - a.data.tarih.valueOf());
---

<Base title={`${k.ad} haberleri`} description={k.aciklama}>
  <section class="section container">
    <a href="/gundem/" class="geri">← Gündem</a>
    <p class="eyebrow" style={`color:${k.renk}`}>Kategori</p>
    <h1>{k.ad}</h1>
    <p class="muted giris">{k.aciklama}</p>
    {haberler.length ? (
      <div class="grid">{haberler.map((h) => <HaberKart haber={h} />)}</div>
    ) : (
      <p class="bos">Bu kategoride henüz haber yok.</p>
    )}
  </section>
</Base>

<style>
  .geri {
    color: var(--muted);
    font-size: 0.9rem;
    display: inline-block;
    margin-bottom: 1.2rem;
  }
  .giris {
    margin-bottom: 2rem;
  }
</style>
