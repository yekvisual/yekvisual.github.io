---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import HaberKart from '../../../components/HaberKart.astro';
import { KATEGORILER } from '../../../lib/taxonomy';

export async function getStaticPaths() {
  return Object.keys(KATEGORILER).map((kategori) => ({ params: { kategori } }));
}

const { kategori } = Astro.params;
const k = KATEGORILER[kategori];
const haberler = (await getCollection('haberler'))
  .filter((h) => h.data.kategori === kategori)
  .sort((a, b) => b.data.tarih.valueOf() - a.data.tarih.valueOf());
---

<Base title={`${k.ad} haberleri`} description={k.aciklama}>
  <section class="container section sayfa-bas">
    <a href="/gundem/" class="kicker geri">← Gündem</a>
    <h1 class="display reveal">{k.ad}</h1>
    <p class="lead reveal" style="--d:80ms">{k.aciklama}</p>
  </section>
  <section class="container">
    {haberler.length ? (
      <div class="cols liste rule" style="--n:3">{haberler.map((h, i) => <div><HaberKart haber={h} gecikme={(i % 3) * 90} /></div>)}</div>
    ) : (
      <p class="bos">Bu kategoride henüz haber yok.</p>
    )}
  </section>
</Base>

<style>
  .sayfa-bas {
    padding-bottom: 1rem;
  }
  .sayfa-bas h1 {
    font-size: clamp(3.2rem, 8vw, 7rem);
  }
  .geri {
    display: inline-block;
    margin-bottom: 1rem;
  }
  .geri:hover {
    color: var(--accent);
  }
  .liste > div {
    padding-block: 1.8rem;
  }
</style>
