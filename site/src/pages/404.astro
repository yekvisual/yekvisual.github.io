---
import Base from '../layouts/Base.astro';
---

<Base title="Sayfa bulunamadı">
  <section class="section container" style="text-align:center;padding-block:6rem">
    <p class="eyebrow">404</p>
    <h1>Burada bir şey <span class="gradient-text">yok</span>.</h1>
    <p class="muted">Sayfa taşınmış ya da hiç olmamış olabilir.</p>
    <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;margin-top:1.5rem">
      <a href="/" class="btn btn-primary">Ana sayfa</a>
      <a href="/ara/" class="btn">Ara</a>
    </div>
  </section>
</Base>
