---
import Base from '../layouts/Base.astro';
---

<Base title="Sayfa bulunamadı">
  <section class="container section" style="text-align:center;padding-block:5rem">
    <p class="kicker kicker-accent">404</p>
    <h1 class="display" style="font-size:clamp(2.6rem,6vw,5rem)">Bu sayfa<br /><em style="color:var(--accent)">basılmamış.</em></h1>
    <p class="lead muted">Sayfa taşınmış ya da hiç olmamış olabilir.</p>
    <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;margin-top:1.5rem">
      <a href="/" class="btn btn-ink">Ana sayfa</a>
      <a href="/ara/" class="btn">Ara</a>
    </div>
  </section>
</Base>
