---
import Base from '../layouts/Base.astro';
import Search from 'astro-pagefind/components/Search.astro';
---

<Base title="Ara" description="Sitede ara">
  <section class="section container yazi">
    <p class="eyebrow">Arama</p>
    <h1>Ne arıyorsun?</h1>
    <Search id="ara" className="pagefind-ui" uiOptions={{ showImages: false, translations: { placeholder: 'Model, araç, konu...', zero_results: 'Sonuç yok: [SEARCH_TERM]', clear_search: 'Temizle', load_more: 'Daha fazla' } }} />
  </section>
</Base>

<style is:global>
  .yazi {
    max-width: 760px;
  }
  .pagefind-ui {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--accent-2);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border-strong);
    --pagefind-ui-tag: var(--surface-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: var(--font-body);
    margin-top: 1.5rem;
  }
  .pagefind-ui__result-link {
    color: var(--accent-2) !important;
  }
  .pagefind-ui__result-excerpt {
    color: var(--text-2) !important;
  }
  .pagefind-ui__message {
    color: var(--muted) !important;
  }
</style>
