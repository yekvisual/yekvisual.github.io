---
// Haber kapağı: görsel varsa optimize edilmiş görsel, yoksa gazete ilanı gibi
// üretilmiş kapak (kategori adı büyük, turuncu çizgi, yekvisual damgası).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { kategoriAdi } from '../lib/taxonomy';

interface Props {
  gorsel?: ImageMetadata;
  kaynak?: string;
  baslik: string;
  kategori: string;
  genislik?: number;
  oncelik?: boolean;
  oran?: string;
}
const { gorsel, kaynak, baslik, kategori, genislik = 800, oncelik = false, oran } = Astro.props;
const stil = oran ? `aspect-ratio:${oran}` : undefined;
---

{gorsel ? (
  <div class="kapak reveal-img" style={stil}>
    <Image src={gorsel} alt="" width={genislik} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 800px" loading={oncelik ? 'eager' : 'lazy'} />
    {kaynak && <span class="kapak-kaynak">{kaynak}</span>}
  </div>
) : (
  <div class="kapak kapak-uretilmis reveal-img" style={stil} aria-hidden="true">
    <span class="kapak-marka">yekvisual</span>
    <span class="kapak-baslik">{kategoriAdi(kategori)}</span>
  </div>
)}
