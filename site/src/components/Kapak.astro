---
// Haber kapağı. Sıra: 1) haberin kendi görseli (resmi görsel, modelin gerçek çıktısı
// ya da kendi denemem), 2) hiçbiri yoksa kategoriye özel soyut kapak. Görselin
// kaynağı küçük bir etiketle her zaman yazılır.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { kategoriAdi, kategoriGradyan } from '../lib/taxonomy';

interface Props {
  gorsel?: ImageMetadata;
  kaynak?: string;
  baslik: string;
  kategori: string;
  genislik?: number;
  oncelik?: boolean;
  oran?: string;
}
const { gorsel, kaynak, baslik, kategori, genislik = 800, oncelik = false, oran } = Astro.props;
const stil = [oran ? `aspect-ratio:${oran}` : '', gorsel ? '' : `--kapak-gradyan:${kategoriGradyan(kategori)}`].filter(Boolean).join(';');
---

<div class:list={['kapak', 'reveal-img', { 'kapak-yedek': !gorsel }]} style={stil || undefined}>
  {gorsel ? (
    <Image src={gorsel} alt="" width={genislik} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 800px" loading={oncelik ? 'eager' : 'lazy'} />
  ) : (
    <span class="kapak-kategori" aria-hidden="true">{kategoriAdi(kategori)}</span>
  )}
  {gorsel && kaynak && <span class="kapak-kaynak">{kaynak}</span>}
</div>
