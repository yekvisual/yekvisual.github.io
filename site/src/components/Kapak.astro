---
// Haber kapağı. Öncelik: haberin kendi görseli (kaynağın resmi görseli ya da deneme);
// yoksa kategoriye özel gravür illüstrasyon (src/assets/kategori/*.webp). Böylece
// hiçbir haber görselsiz kalmaz.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  gorsel?: ImageMetadata;
  kaynak?: string;
  baslik: string;
  kategori: string;
  genislik?: number;
  oncelik?: boolean;
  oran?: string;
}
const { gorsel, kaynak, baslik, kategori, genislik = 800, oncelik = false, oran } = Astro.props;

const kategoriGorselleri = import.meta.glob<{ default: ImageMetadata }>('../assets/kategori/*.webp', { eager: true });
const yedek = kategoriGorselleri[`../assets/kategori/${kategori}.webp`]?.default ?? kategoriGorselleri['../assets/kategori/araclar.webp']?.default;

const src = gorsel ?? yedek;
const altyazi = gorsel ? kaynak : 'İllüstrasyon: yekvisual';
const stil = oran ? `aspect-ratio:${oran}` : undefined;
---

<div class:list={['kapak', 'reveal-img', { 'kapak-yedek': !gorsel }]} style={stil}>
  {src && (
    <Image src={src} alt="" width={genislik} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 800px" loading={oncelik ? 'eager' : 'lazy'} />
  )}
  {altyazi && <span class="kapak-kaynak">{altyazi}</span>}
</div>

<style>
  /* Kategori illüstrasyonları krem zeminli; kâğıda basılmış gibi görünsün */
  .kapak-yedek img {
    mix-blend-mode: multiply;
  }
</style>
