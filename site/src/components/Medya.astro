---
// Haber içindeki medya: görsel, video dosyası ya da YouTube gömme.
// `src` içerik dosyasına göreli bir yol ise content/ altından okunur.
interface Medya {
  tip: 'gorsel' | 'video' | 'youtube';
  src: string;
  alt?: string;
  kaynak?: string;
}
interface Props {
  medya: Medya;
  haberId?: string;
}
const { medya, haberId } = Astro.props;

function youtubeId(url: string) {
  const m = url.match(/(?:v=|youtu\.be\/|shorts\/|embed\/)([\w-]{6,})/);
  return m?.[1];
}

// Göreli medya yolları build sırasında /medya/<haber-id>/<dosya> olarak kopyalanır (bkz. public/medya).
const yerel = medya.src.startsWith('./') && haberId ? `/medya/${haberId}/${medya.src.slice(2)}` : medya.src;
---

<figure class="medya">
  {medya.tip === 'youtube' && youtubeId(medya.src) && (
    <div class="video-cerceve">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${youtubeId(medya.src)}`}
        title={medya.alt || 'Video'}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>
  )}
  {medya.tip === 'video' && <video src={yerel} controls muted loop playsinline preload="metadata" />}
  {medya.tip === 'gorsel' && <img src={yerel} alt={medya.alt ?? ''} loading="lazy" />}
  {(medya.alt || medya.kaynak) && (
    <figcaption>
      {medya.alt}
      {medya.kaynak && <span class="muted"> · {medya.kaynak}</span>}
    </figcaption>
  )}
</figure>

<style>
  .medya {
    margin: 1.5rem 0;
  }
  .medya img,
  .medya video {
    width: 100%;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }
  .video-cerceve {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
    background: #000;
  }
  .video-cerceve iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  figcaption {
    font-size: 0.82rem;
    color: var(--text-2);
    margin-top: 0.5rem;
  }
</style>
