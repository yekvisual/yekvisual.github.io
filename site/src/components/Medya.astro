---
// Haber içindeki medya: görsel, video dosyası ya da YouTube gömme.
// `src` içerik dosyasına göreli bir yol ise (./<slug>/deneme-1.webp) content/haberler
// altından build sırasında alınır: görseller astro:assets ile, videolar Vite ?url ile.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Medya {
  tip: 'gorsel' | 'video' | 'youtube';
  src: string;
  alt?: string;
  kaynak?: string;
}
interface Props {
  medya: Medya;
  haberId?: string;
}
const { medya, haberId } = Astro.props;

const gorseller = import.meta.glob<ImageMetadata>('../../../content/haberler/**/*.{webp,png,jpg,jpeg,gif}', { eager: true, import: 'default' });
const videolar = import.meta.glob<string>('../../../content/haberler/**/*.{mp4,webm}', { eager: true, query: '?url', import: 'default' });

function youtubeId(url: string) {
  const m = url.match(/(?:v=|youtu\.be\/|shorts\/|embed\/)([\w-]{6,})/);
  return m?.[1];
}

// Göreli yol → content/haberler/<haber klasörü>/<dosya>
const goreli = medya.src.startsWith('./') && Boolean(haberId);
const klasor = haberId ? haberId.split('/').slice(0, -1).join('/') : '';
const anahtar = goreli ? `../../../content/haberler/${klasor ? klasor + '/' : ''}${medya.src.slice(2)}` : '';
const yerelGorsel = goreli ? gorseller[anahtar] : undefined;
const yerelVideo = goreli ? videolar[anahtar] : undefined;
const uzak = goreli ? undefined : medya.src;
---

<figure class="medya">
  {medya.tip === 'youtube' && youtubeId(medya.src) && (
    <div class="video-cerceve">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${youtubeId(medya.src)}`}
        title={medya.alt || 'Video'}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>
  )}
  {medya.tip === 'video' && (yerelVideo || uzak) && <video src={yerelVideo ?? uzak} controls muted loop playsinline preload="metadata" />}
  {medya.tip === 'gorsel' && yerelGorsel && (
    <Image src={yerelGorsel} alt={medya.alt ?? ''} width={1400} widths={[700, 1000, 1400]} sizes="(max-width: 760px) 100vw, 720px" loading="lazy" />
  )}
  {medya.tip === 'gorsel' && !yerelGorsel && uzak && <img src={uzak} alt={medya.alt ?? ''} loading="lazy" />}
  {(medya.alt || medya.kaynak) && (
    <figcaption>
      {medya.alt}
      {medya.kaynak && <span class="muted"> · {medya.kaynak}</span>}
    </figcaption>
  )}
</figure>

<style>
  .medya {
    margin: 1.5rem 0;
  }
  .medya img,
  .medya video {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .video-cerceve {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #000;
  }
  .video-cerceve iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  figcaption {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }
</style>
