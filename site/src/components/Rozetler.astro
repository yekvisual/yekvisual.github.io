---
// Gazete etiketleri: kategori (kicker), ücretsiz/ücretli, açık kaynak, zorluk, örnek, yeni.
import { kategoriAdi, zorlukAdi } from '../lib/taxonomy';

interface Props {
  kategori?: string;
  ucretsiz?: boolean | null;
  acikKaynak?: boolean | null;
  zorluk?: string;
  ornek?: boolean;
  yeni?: boolean;
  kategoriLink?: boolean;
}
const { kategori, ucretsiz, acikKaynak, zorluk, ornek, yeni, kategoriLink = true } = Astro.props;
---

<div class="etiketler">
  {kategori && kategoriLink && <a href={`/gundem/kategori/${kategori}/`} class="kicker kicker-link">{kategoriAdi(kategori)}</a>}
  {kategori && !kategoriLink && <span class="kicker">{kategoriAdi(kategori)}</span>}
  {yeni && <span class="etiket">Yeni</span>}
  {ucretsiz === true && <span class="etiket">Ücretsiz</span>}
  {ucretsiz === false && <span class="etiket etiket-outline">Ücretli</span>}
  {acikKaynak === true && <span class="etiket etiket-outline">Açık kaynak</span>}
  {zorluk && <span class="etiket etiket-ince">{zorlukAdi(zorluk)}</span>}
  {ornek && <span class="etiket etiket-ornek">Örnek</span>}
</div>

<style>
  .kicker-link:hover {
    color: var(--accent);
  }
</style>
