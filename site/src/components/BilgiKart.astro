---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { kartYolu } from '../lib/site';
import { zorlukAdi, kategoriAdi } from '../lib/taxonomy';

interface Props {
  kart: CollectionEntry<'kartlar'>;
  gecikme?: number;
}
const { kart, gecikme = 0 } = Astro.props;
const d = kart.data;
const zemin = '#fbfaf8';
---

<article class="bilgi kart reveal" style={`--d:${gecikme}ms`}>
  <div class="bilgi-gorsel" style={`background:${zemin}`}>
    {d.gorsel ? (
      <Image src={d.gorsel} alt="" width={720} widths={[480, 720, 960]} sizes="(max-width: 860px) 100vw, 25vw" loading="lazy" />
    ) : (
      <span class="bilgi-ikon" aria-hidden="true">{d.ikon}</span>
    )}
  </div>
  <div class="bilgi-govde">
    <span class="kicker">{String(d.sira).padStart(2, '0')} · {kategoriAdi(d.kategori)} · {zorlukAdi(d.zorluk)}</span>
    <h3><a href={kartYolu(kart.id)}>{d.baslik}</a></h3>
    <p>{d.ozet}</p>
  </div>
</article>

<style>
  .bilgi {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .bilgi:hover {
    border-color: var(--line-2);
    transform: translateY(-2px);
  }
  .bilgi-gorsel {
    aspect-ratio: 5 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .bilgi-gorsel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .bilgi:hover .bilgi-gorsel img {
    transform: scale(1.03);
  }
  .bilgi-ikon {
    font-size: 2.6rem;
  }
  .bilgi-govde {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1rem 1.1rem 1.2rem;
  }
  .bilgi h3 {
    margin: 0;
    font-size: clamp(1.2rem, 1.4vw, 1.4rem);
    line-height: 1.18;
  }
  .bilgi h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .bilgi:hover h3 {
    color: var(--accent);
  }
  .bilgi p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.92rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
