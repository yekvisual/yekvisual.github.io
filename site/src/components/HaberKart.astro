---
import type { CollectionEntry } from 'astro:content';
import Kapak from './Kapak.astro';
import Rozetler from './Rozetler.astro';
import { haberYolu, tarihTR } from '../lib/site';

interface Props {
  haber: CollectionEntry<'haberler'>;
  boyut?: 'kucuk' | 'normal' | 'manset';
  gecikme?: number;
}
const { haber, boyut = 'normal', gecikme = 0 } = Astro.props;
const d = haber.data;
const yol = haberYolu(haber.id);
const yeni = Date.now() - d.tarih.valueOf() < 3 * 86400_000;
---

<article
  class:list={['card', `card-${boyut}`, 'reveal']}
  style={`--d:${gecikme}ms`}
  data-kategori={d.kategori}
  data-ucretsiz={d.ucretsiz === true ? '1' : '0'}
  data-acik={d.acik_kaynak === true ? '1' : '0'}
  data-zorluk={d.zorluk}
>
  <a href={yol} class="kapak-link" tabindex="-1" aria-hidden="true">
    <Kapak gorsel={d.kapak} kaynak={d.kapak_kaynak} baslik={d.baslik} kategori={d.kategori} genislik={boyut === 'manset' ? 1400 : 700} oncelik={boyut === 'manset'} oran={boyut === 'manset' ? '16 / 10' : '16 / 10'} />
  </a>
  <div class="card-govde">
    <div class="card-meta">
      <Rozetler kategori={d.kategori} yeni={yeni} ornek={d.ornek} kategoriLink={false} />
    </div>
    <h3><a href={yol}>{d.baslik}</a></h3>
    <p>{d.ozet}</p>
    <div class="card-alt">
      <span class="kicker muted">
        <time datetime={d.tarih.toISOString()}>{tarihTR(d.tarih)}</time>
        {d.sirket && <span> · {d.sirket}</span>}
      </span>
      <Rozetler ucretsiz={d.ucretsiz} acikKaynak={d.acik_kaynak} zorluk={d.zorluk} />
    </div>
  </div>
</article>

<style>
  .card-govde {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .card-alt {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.2rem;
  }
  .card-kucuk h3 {
    font-size: 1.35rem;
  }
  .card-kucuk p {
    font-size: 0.92rem;
    -webkit-line-clamp: 3;
  }
  .card-manset {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .card-manset {
      grid-template-columns: 1.45fr 1fr;
      align-items: center;
    }
    .card-manset .card-govde {
      padding-left: 1.5rem;
      border-left: 1px solid var(--rule);
      gap: 0.9rem;
    }
  }
  .card-manset h3 {
    font-size: clamp(2.2rem, 3.8vw, 3.6rem);
    line-height: 0.95;
  }
  .card-manset p {
    font-size: 1.12rem;
    line-height: 1.45;
    -webkit-line-clamp: 5;
  }
</style>
