---
import type { CollectionEntry } from 'astro:content';
import Kapak from './Kapak.astro';
import Rozetler from './Rozetler.astro';
import { haberYolu, tarihTR, tarihKisa } from '../lib/site';
import { kategoriAdi } from '../lib/taxonomy';

interface Props {
  haber: CollectionEntry<'haberler'>;
  boyut?: 'satir' | 'kucuk' | 'normal' | 'manset';
  gecikme?: number;
}
const { haber, boyut = 'normal', gecikme = 0 } = Astro.props;
const d = haber.data;
const yol = haberYolu(haber.id);
const yeni = Date.now() - d.tarih.valueOf() < 3 * 86400_000;
---

{boyut === 'satir' ? (
  <article class="satir reveal" style={`--d:${gecikme}ms`} data-kategori={d.kategori} data-ucretsiz={d.ucretsiz === true ? '1' : '0'} data-acik={d.acik_kaynak === true ? '1' : '0'} data-zorluk={d.zorluk}>
    <time class="satir-tarih num" datetime={d.tarih.toISOString()}>{tarihKisa(d.tarih)}</time>
    <span class="satir-ic">
      <a href={yol} class="satir-baslik">{d.baslik}</a>
      <span class="satir-meta">{kategoriAdi(d.kategori)}{d.sirket && ` · ${d.sirket}`}</span>
    </span>
    <span class="satir-rozet">
      {d.acik_kaynak === true ? <span class="etiket etiket-acik">Açık</span> : d.ucretsiz === true ? <span class="etiket etiket-ucretsiz">Ücretsiz</span> : d.ucretsiz === false ? <span class="etiket etiket-ucretli">Ücretli</span> : yeni ? <span class="etiket etiket-yeni">Yeni</span> : null}
    </span>
  </article>
) : (
  <article
    class:list={['card', `card-${boyut}`, 'reveal']}
    style={`--d:${gecikme}ms`}
    data-kategori={d.kategori}
    data-ucretsiz={d.ucretsiz === true ? '1' : '0'}
    data-acik={d.acik_kaynak === true ? '1' : '0'}
    data-zorluk={d.zorluk}
  >
    <a href={yol} class="kapak-link" tabindex="-1" aria-hidden="true">
      <Kapak gorsel={d.kapak} kaynak={d.kapak_kaynak} baslik={d.baslik} kategori={d.kategori} genislik={boyut === 'manset' ? 1400 : 700} oncelik={boyut === 'manset'} oran={boyut === 'manset' ? '16 / 9' : '16 / 10'} />
    </a>
    <div class="card-govde">
      <div class="card-meta">
        <span class="kicker">
          <time datetime={d.tarih.toISOString()}>{tarihTR(d.tarih)}</time>
          {d.sirket && <span> · {d.sirket}</span>}
          {d.yekvisual_notu && <span class="not-var"> · yekvisual analizi</span>}
        </span>
      </div>
      <h3><a href={yol}>{d.baslik}</a></h3>
      <p>{d.ozet}</p>
      <div class="card-alt">
        <Rozetler kategori={d.kategori} yeni={yeni} ornek={d.ornek} kategoriLink={false} ucretsiz={d.ucretsiz} acikKaynak={d.acik_kaynak} />
      </div>
    </div>
  </article>
)}

<style>
  .card-govde {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card-alt {
    margin-top: 0.2rem;
  }
  .not-var {
    color: var(--accent);
    text-transform: none;
    letter-spacing: 0;
  }
  .card-kucuk h3 {
    font-size: 1.25rem;
  }
  .card-kucuk p {
    font-size: 0.9rem;
    -webkit-line-clamp: 2;
  }
  .card-manset h3 {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1.1;
  }
  .card-manset p {
    font-size: 1.08rem;
    line-height: 1.5;
    -webkit-line-clamp: 4;
    max-width: 62ch;
  }

  /* Satır görünümü: "Bugün" sütunu */
  .satir {
    display: grid;
    grid-template-columns: 3.4rem 1fr auto;
    gap: 0.8rem;
    align-items: start;
    padding: 0.8rem 0;
    border-top: 1px solid var(--line);
  }
  .satir:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .satir-tarih {
    font-size: 0.78rem;
    color: var(--muted);
    padding-top: 0.15rem;
  }
  .satir-ic {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .satir-baslik {
    font-weight: 500;
    line-height: 1.35;
  }
  .satir-baslik:hover {
    color: var(--accent);
  }
  .satir-meta {
    font-size: 0.78rem;
    color: var(--muted);
  }
</style>
