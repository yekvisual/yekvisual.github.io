---
// Haftalık özet kutusu: e-posta (Buttondown) ve Instagram, yan yana.
import { SITE } from '../lib/site';
const formUrl = SITE.bultenFormUrl;
---

<section class="bulten band reveal" id="bulten">
  <div class="parilti" aria-hidden="true"></div>
  <div class="bulten-ic">
    <p class="kicker kicker-acik">Haftalık özet · her Pazar 20:00</p>
    <h2>Pazar akşamı kahvenle: haftanın tamamı, 5 dakikada.</h2>
    <p class="aciklama">Pazartesiden pazara ne çıktı, hangisini denedim, gelecek hafta ne var. Reklam yok, spam yok.</p>
    {formUrl ? (
      <form action={formUrl} method="post" target="_blank" class="form">
        <label class="sr-only" for="bulten-email">E-posta</label>
        <input id="bulten-email" type="email" name="email" placeholder="e-posta adresin" autocomplete="email" required />
        <button class="btn btn-accent" type="submit">E-postayla al</button>
      </form>
    ) : null}
    <div class="ya-da">
      <span class="muted-acik">ya da</span>
      <a class="btn btn-acik" href={SITE.instagram} target="_blank" rel="noopener">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
        Instagram'da takip et
      </a>
    </div>
  </div>
</section>

<style>
  .bulten {
    position: relative;
    overflow: hidden;
    padding: clamp(1.8rem, 4vw, 2.6rem) clamp(1.2rem, 3vw, 2.4rem);
    height: 100%;
  }
  .parilti {
    position: absolute;
    right: -120px;
    top: -120px;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(closest-side, #ffd43b 0%, #ff9f1c 45%, #ff7a45 70%, rgba(255, 122, 69, 0) 100%);
    opacity: 0.55;
    pointer-events: none;
  }
  .bulten-ic {
    position: relative;
    max-width: 640px;
  }
  .bulten h2 {
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    font-weight: 400;
    margin-bottom: 0.4em;
  }
  .kicker-acik {
    color: #b8b3aa;
  }
  .aciklama {
    color: #d6d1c8;
    font-size: 0.98rem;
  }
  .form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin-top: 1.1rem;
  }
  input {
    flex: 1 1 200px;
    font: inherit;
    font-size: 0.95rem;
    height: 2.8rem;
    padding: 0 1rem;
    border: 1px solid #45433f;
    background: #2a2926;
    color: var(--bg);
    border-radius: 10px;
  }
  input::placeholder {
    color: #8a867f;
  }
  input:focus {
    outline: 1px solid var(--sari);
    outline-offset: 2px;
  }
  .ya-da {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.9rem;
    flex-wrap: wrap;
  }
  .muted-acik {
    font-size: 0.85rem;
    color: #8a867f;
  }
  .btn-acik {
    background: transparent;
    border-color: #45433f;
    color: var(--bg);
  }
  .btn-acik:hover {
    background: var(--bg);
    color: var(--ink);
    border-color: var(--bg);
  }
</style>
