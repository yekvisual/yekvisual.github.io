---
import { SITE } from '../lib/site';
const aktif = Boolean(SITE.bultenFormUrl);
---

<section class="bulten band reveal">
  <div class="bulten-ic">
    <p class="kicker kicker-paper">Haftalık bülten · Her pazar</p>
    <h2 class="display">Haftada bir e-posta, <em>sıfır gürültü.</em></h2>
    <p class="aciklama">Haftanın en önemli beş gelişmesi, ne işine yarayacağıyla birlikte.</p>
    {aktif ? (
      <form action={SITE.bultenFormUrl} method="post" target="_blank" class="form">
        <label class="sr-only" for="bulten-email">E-posta</label>
        <input id="bulten-email" type="email" name="email" placeholder="e-posta adresin" required />
        <button class="btn btn-paper" type="submit">Abone ol</button>
      </form>
    ) : (
      <div class="form">
        <a class="btn btn-paper" href={SITE.instagram} target="_blank" rel="noopener">Şimdilik Instagram'dan takip et</a>
        <span class="kicker kicker-paper">Bülten çok yakında</span>
      </div>
    )}
  </div>
</section>

<style>
  .bulten {
    padding: clamp(2rem, 5vw, 4rem) clamp(1.2rem, 4vw, 3.5rem);
    border: 1px solid var(--ink);
  }
  .bulten-ic {
    max-width: 720px;
  }
  .bulten h2 {
    font-size: clamp(2.4rem, 5.5vw, 5rem);
    text-transform: none;
    margin-bottom: 0.4em;
  }
  .bulten em {
    font-style: italic;
    color: var(--accent);
  }
  .kicker-paper {
    color: rgba(217, 210, 200, 0.75);
  }
  .aciklama {
    color: rgba(217, 210, 200, 0.85);
    font-size: 1.05rem;
  }
  .form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin-top: 1.2rem;
  }
  input {
    flex: 1 1 220px;
    font: inherit;
    font-size: 1rem;
    padding: 0.7rem 1rem;
    border: 1px solid rgba(217, 210, 200, 0.5);
    background: transparent;
    color: var(--paper);
    border-radius: 999px;
  }
  input::placeholder {
    color: rgba(217, 210, 200, 0.5);
  }
  input:focus {
    outline: 1px solid var(--paper);
    outline-offset: 2px;
  }
  .btn-paper {
    border-color: var(--paper);
    color: var(--paper);
  }
  .btn-paper:hover {
    background: var(--paper);
    color: var(--ink);
  }
</style>
