---
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  tarih?: Date;
}

const { title, description = SITE.aciklama, image, type = 'website', tarih } = Astro.props;
const tamBaslik = title ? `${title} · ${SITE.ad}` : `${SITE.ad} · ${SITE.slogan}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og/site.png', Astro.site);
const yol = Astro.url.pathname;
const nav = [
  { href: '/gundem/', ad: 'Gündem' },
  { href: '/modeller/', ad: 'Modeller' },
  { href: '/bilmeniz-gerekenler/', ad: 'İş Akışları' },
  { href: '/araclar/', ad: 'Araçlar' },
  { href: '/haftalik/', ad: 'Haftalık' },
];
const yil = new Date().getFullYear();
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.ad} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.ad} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.ad} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="tr_TR" />
    {tarih && <meta property="article:published_time" content={tarih.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfaf8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Geist:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#icerik">İçeriğe geç</a>

    <header class="ust">
      <div class="container ust-ic">
        <a href="/" class="logo" aria-label={`${SITE.ad} ana sayfa`}>YEK Lab<span class="nokta">.</span></a>
        <nav class="nav" id="nav" aria-label="Site">
          {nav.map((n) => (
            <a href={n.href} aria-current={yol.startsWith(n.href) ? 'page' : undefined}>{n.ad}</a>
          ))}
        </nav>
        <div class="ust-sag">
          <a href="/ara/" class="ara" aria-label="Ara">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
            <span>Ara</span>
          </a>
          <a href={SITE.instagram} class="ig" target="_blank" rel="noopener" aria-label="Instagram">
            <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
          </a>
          <a href="/haftalik/#bulten" class="btn btn-ink bulten-btn">Bülten</a>
          <button class="menu" id="menu" aria-expanded="false" aria-controls="nav" aria-label="Menü">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="icerik">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-ic">
        <a href="/" class="logo logo-kucuk">YEK Lab<span class="nokta">.</span></a>
        <div class="footer-linkler">
          {nav.map((n) => <a href={n.href}>{n.ad}</a>)}
          <a href="/hakkinda/">Hakkında</a>
          <a href="/rss.xml">RSS</a>
          <a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a>
        </div>
        <div class="footer-not">Türkçe, bağımsız, her gün. © {yil} YEK Lab · {SITE.kurucu}</div>
      </div>
    </footer>

    <script>
      import Lenis from 'lenis';

      const azHareket = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!azHareket) {
        const lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
        const raf = (t: number) => {
          lenis.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      const io = new IntersectionObserver(
        (girdiler) => {
          for (const g of girdiler) {
            if (g.isIntersecting) {
              g.target.classList.add('in');
              io.unobserve(g.target);
            }
          }
        },
        { rootMargin: '0px 0px -6% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('.reveal, .reveal-img').forEach((el) => io.observe(el));

      const btn = document.getElementById('menu');
      const nav = document.getElementById('nav');
      btn?.addEventListener('click', () => {
        const acik = nav?.classList.toggle('acik');
        btn.setAttribute('aria-expanded', String(!!acik));
      });
    </script>

    <style>
      .ust {
        position: relative;
        z-index: 20;
        background: var(--bg);
      }
      .ust-ic {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1.1rem 0 0.9rem;
      }
      .logo {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 1.75rem;
        line-height: 1;
        letter-spacing: -0.01em;
        color: var(--ink);
        white-space: nowrap;
      }
      .nokta {
        color: var(--accent);
      }
      .logo-kucuk {
        font-size: 1.4rem;
      }
      .nav {
        display: flex;
        gap: clamp(1rem, 2vw, 1.7rem);
        font-size: 0.95rem;
        font-weight: 500;
      }
      .nav a {
        position: relative;
        padding-bottom: 2px;
      }
      .nav a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -3px;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s var(--ease);
      }
      .nav a:hover::after,
      .nav a[aria-current='page']::after {
        transform: scaleX(1);
      }
      .ust-sag {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .ara {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        height: 2.3rem;
        padding: 0 0.9rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--bg-2);
        color: var(--muted);
        font-size: 0.88rem;
        font-weight: 500;
      }
      .ara:hover {
        color: var(--ink);
        border-color: var(--line-2);
      }
      .ig {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.3rem;
        height: 2.3rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--bg-2);
      }
      .ig:hover {
        color: var(--accent);
        border-color: var(--line-2);
      }
      .bulten-btn {
        height: 2.3rem;
        padding: 0 1rem;
        font-size: 0.88rem;
      }
      .menu {
        display: none;
        background: none;
        border: 0;
        width: 36px;
        height: 32px;
        cursor: pointer;
        flex-direction: column;
        justify-content: center;
        gap: 6px;
        padding: 0 4px;
      }
      .menu span {
        height: 1.5px;
        background: var(--ink);
      }
      @media (max-width: 900px) {
        .ara span,
        .bulten-btn {
          display: none;
        }
        .menu {
          display: flex;
        }
        .nav {
          display: none;
          position: absolute;
          left: 0;
          right: 0;
          top: 100%;
          flex-direction: column;
          gap: 0;
          background: var(--bg);
          border-top: 1px solid var(--line);
          border-bottom: 1px solid var(--line);
          padding: 0.4rem var(--gutter) 0.6rem;
          font-size: 1.05rem;
        }
        .nav.acik {
          display: flex;
        }
        .nav a {
          padding: 0.75rem 0;
          border-bottom: 1px solid var(--line);
        }
        .nav a::after {
          display: none;
        }
        .ara {
          width: 2.3rem;
          padding: 0;
          justify-content: center;
        }
      }
      .footer {
        margin-top: 4.5rem;
        border-top: 1px solid var(--line);
        padding: 1.8rem 0 2.5rem;
      }
      .footer-ic {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.2rem;
        flex-wrap: wrap;
      }
      .footer-linkler {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        font-size: 0.9rem;
        color: var(--ink-2);
      }
      .footer-linkler a:hover {
        color: var(--accent);
      }
      .footer-not {
        font-size: 0.85rem;
        color: var(--muted);
      }
    </style>
  </body>
</html>
