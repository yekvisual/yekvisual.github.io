---
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { SITE, haberYolu, tarihTR } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  tarih?: Date;
}

const { title, description = SITE.aciklama, image, type = 'website', tarih } = Astro.props;
const tamBaslik = title ? `${title} · ${SITE.ad}` : `${SITE.ad} · ${SITE.slogan}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og/site.png', Astro.site);
const yol = Astro.url.pathname;
const nav = [
  { href: '/bilmeniz-gerekenler/', ad: 'Bilmeniz Gerekenler' },
  { href: '/gundem/', ad: 'Gündem' },
  { href: '/araclar/', ad: 'Araçlar' },
  { href: '/haftalik/', ad: 'Haftalık' },
  { href: '/hakkinda/', ad: 'Hakkında' },
];
const bugun = new Date();
const sonHaberler = (await getCollection('haberler')).sort((a, b) => b.data.tarih.valueOf() - a.data.tarih.valueOf()).slice(0, 8);
const sayi = (await getCollection('ozetler')).length + 1;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.ad} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.ad} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.ad} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="tr_TR" />
    {tarih && <meta property="article:published_time" content={tarih.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#d9d2c8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Grenze+Gotisch:wght@700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#icerik">İçeriğe geç</a>

    <header class="masthead">
      <div class="container ust">
        <div class="ust-sol kicker">
          <span>Türkiye</span>
          <span class="ust-tarih">{tarihTR(bugun)}</span>
        </div>
        <a href="/" class="logo" aria-label={`${SITE.ad} ana sayfa`}>yekvisual</a>
        <div class="ust-sag kicker">
          <span class="sayi">Sayı {String(sayi).padStart(2, '0')}</span>
          <button class="menu" id="menu" aria-expanded="false" aria-controls="nav" aria-label="Menü">
            <span></span><span></span>
          </button>
        </div>
      </div>
      <nav class="nav rule-double" id="nav">
        <div class="container nav-ic">
          {nav.map((n) => (
            <a href={n.href} aria-current={yol.startsWith(n.href) ? 'page' : undefined}>{n.ad}</a>
          ))}
          <a href="/ara/" class="nav-ara" aria-label="Ara">Ara</a>
          <a href={SITE.instagram} class="nav-ig" target="_blank" rel="noopener">Instagram ↗</a>
        </div>
      </nav>
      {sonHaberler.length > 0 && (
        <div class="ticker" aria-label="Son haberler">
          <div class="ticker-ic">
            {[...sonHaberler, ...sonHaberler].map((h) => (
              <a href={haberYolu(h.id)}>
                <span class="ticker-nokta" aria-hidden="true"></span>
                {h.data.baslik}
              </a>
            ))}
          </div>
        </div>
      )}
    </header>

    <main id="icerik">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-ust rule-double">
          <a href="/" class="logo logo-kucuk">yekvisual</a>
          <p class="footer-slogan">{SITE.slogan}</p>
        </div>
        <div class="footer-alt">
          <div class="kicker">© {bugun.getFullYear()} yekvisual · Sayı {String(sayi).padStart(2, '0')}</div>
          <div class="footer-linkler kicker">
            <a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a>
            <a href="/rss.xml">RSS</a>
            <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
            <a href="/hakkinda/">Hakkında</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      import Lenis from 'lenis';

      const azHareket = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Yumuşak kaydırma
      if (!azHareket) {
        const lenis = new Lenis({ lerp: 0.09, smoothWheel: true });
        const raf = (t: number) => {
          lenis.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      // Kaydırdıkça açılma
      const io = new IntersectionObserver(
        (girdiler) => {
          for (const g of girdiler) {
            if (g.isIntersecting) {
              g.target.classList.add('in');
              io.unobserve(g.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('.reveal, .reveal-img').forEach((el) => io.observe(el));

      // Sayaçlar
      const sayacIo = new IntersectionObserver((girdiler) => {
        for (const g of girdiler) {
          if (!g.isIntersecting) continue;
          const el = g.target as HTMLElement;
          const hedef = Number(el.dataset.sayac ?? el.textContent);
          const basla = performance.now();
          const sure = 1200;
          const adim = (t: number) => {
            const p = Math.min(1, (t - basla) / sure);
            const e = 1 - Math.pow(1 - p, 3);
            el.textContent = String(Math.round(hedef * e)).padStart(2, '0');
            if (p < 1) requestAnimationFrame(adim);
          };
          if (azHareket) el.textContent = String(hedef).padStart(2, '0');
          else requestAnimationFrame(adim);
          sayacIo.unobserve(el);
        }
      });
      document.querySelectorAll('[data-sayac]').forEach((el) => sayacIo.observe(el));

      // Mobil menü
      const btn = document.getElementById('menu');
      const nav = document.getElementById('nav');
      btn?.addEventListener('click', () => {
        const acik = nav?.classList.toggle('acik');
        btn.setAttribute('aria-expanded', String(!!acik));
      });
    </script>

    <style>
      .masthead {
        position: relative;
        z-index: 20;
      }
      .ust {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 1.1rem 0 0.7rem;
      }
      .ust-sol,
      .ust-sag {
        display: flex;
        gap: 1.2rem;
        align-items: center;
      }
      .ust-sag {
        justify-content: flex-end;
      }
      .logo {
        font-family: var(--font-masthead);
        font-weight: 700;
        font-size: clamp(2.3rem, 4.4vw, 3.6rem);
        line-height: 1;
        color: var(--ink);
        letter-spacing: 0.01em;
      }
      .logo-kucuk {
        font-size: 2.1rem;
      }
      .menu {
        display: none;
        background: none;
        border: 0;
        width: 36px;
        height: 32px;
        cursor: pointer;
        flex-direction: column;
        justify-content: center;
        gap: 6px;
        padding: 0 4px;
      }
      .menu span {
        height: 1.5px;
        background: var(--ink);
      }
      .nav-ic {
        display: flex;
        justify-content: center;
        gap: clamp(1rem, 2.5vw, 2.2rem);
        padding: 0.7rem 0 0.55rem;
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.86rem;
      }
      .nav-ic a {
        position: relative;
        padding-bottom: 2px;
      }
      .nav-ic a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2px;
        height: 1px;
        background: var(--ink);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.35s var(--ease);
      }
      .nav-ic a:hover::after,
      .nav-ic a[aria-current='page']::after {
        transform: scaleX(1);
      }
      .nav-ig {
        color: var(--accent);
      }
      .ticker {
        overflow: hidden;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        font-size: 0.92rem;
        font-style: italic;
      }
      .ticker-ic {
        display: flex;
        gap: 2.5rem;
        width: max-content;
        padding: 0.45rem 0;
        animation: kay 70s linear infinite;
      }
      .ticker:hover .ticker-ic {
        animation-play-state: paused;
      }
      .ticker-ic a {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        white-space: nowrap;
      }
      .ticker-ic a:hover {
        color: var(--accent);
      }
      .ticker-nokta {
        width: 6px;
        height: 6px;
        background: var(--accent);
        border-radius: 50%;
      }
      @keyframes kay {
        to {
          transform: translateX(-50%);
        }
      }
      @media (max-width: 860px) {
        .ust-tarih,
        .sayi {
          display: none;
        }
        .menu {
          display: flex;
        }
        .nav {
          display: none;
        }
        .nav.acik {
          display: block;
        }
        .nav-ic {
          flex-direction: column;
          gap: 0;
          padding: 0.3rem 0 0.6rem;
          font-size: 1rem;
        }
        .nav-ic a {
          padding: 0.75rem 0;
          border-bottom: 1px solid var(--rule);
        }
        .nav-ic a::after {
          display: none;
        }
      }
      .footer {
        margin-top: 4rem;
        padding-bottom: 2.5rem;
      }
      .footer-ust {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding-top: 1.2rem;
        flex-wrap: wrap;
      }
      .footer-slogan {
        font-style: italic;
        color: var(--ink-2);
        margin: 0;
      }
      .footer-alt {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
        padding-top: 0.6rem;
        border-top: 1px solid var(--rule);
      }
      .footer-linkler {
        display: flex;
        gap: 1.4rem;
      }
      .footer-linkler a:hover {
        color: var(--accent);
      }
    </style>
  </body>
</html>
